# syntax=docker/dockerfile:1.6
# Editor runtime — CPU.
# Used by /api/editor/runs when the GPU toggle is off.

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN pip install --no-cache-dir \
    numpy \
    pandas \
    scikit-learn \
    requests

WORKDIR /workspace

# Default command is overridden by the backend with the runner path.
CMD ["python", "-c", "print('editor runtime ready')"]
